MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/policydesk
GEMINI_API_KEY=replace_with_your_gemini_key
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
PORT=5001
CLIENT_ORIGIN=http://localhost:5173
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
RETRIEVAL_THRESHOLD=0.28
# Production: NODE_ENV=production, CLIENT_ORIGIN=https://your-domain.example
# Set TRUST_PROXY=1 only behind exactly one trusted reverse proxy.
TRUST_PROXY=0
